---
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Service {
  no: string;
  title: string;
  body: string;
  price: string;
  imageNote: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<section id="services" class="services">
  <p class="section-label">SERVICES</p>
  <h2 class="section-heading" style="margin-bottom:32px;">提供しているもの</h2>

  <div class="services__list">
    {services.map((sv) => (
      <div class="services__card">
        <div class="services__image">
          <ImagePlaceholder label={sv.imageNote} height={120} radius={12} padding={12} fontSize={11} labelPadding="5px 9px" />
        </div>
        <p class="services__no">{sv.no}</p>
        <h3 class="services__title">{sv.title}</h3>
        <p class="services__body">{sv.body}</p>
        <p class="services__price">{sv.price}</p>
        <a href="#contact" class="btn-secondary">くわしく相談する</a>
      </div>
    ))}
  </div>
</section>

<style>
  .services {
    padding: 64px 28px;
    background: var(--color-section-bg);
  }

  .services__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .services__card {
    padding: 28px 24px;
    border-radius: 20px;
    background: var(--color-base-bg);
  }

  .services__image {
    margin-bottom: 20px;
  }

  .services__no {
    margin: 0 0 10px;
    font-family: var(--font-label);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--color-brand);
  }

  .services__title {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.6;
  }

  .services__body {
    margin: 0 0 18px;
    font-size: 14.5px;
    line-height: 2.05;
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  .services__price {
    margin: 0 0 20px;
    font-size: 14px;
    color: var(--color-text-strong);
  }
</style>
